:root{--black:#080706;--panel:#11100e;--cream:#f2eadc;--muted:#aaa39a;--gold:#c98a36;--line:#2b2823}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--black);color:var(--cream);font-family:Inter,Arial,sans-serif}a{color:inherit;text-decoration:none}header{position:fixed;z-index:30;top:0;left:0;right:0;height:78px;padding:0 5vw;display:flex;align-items:center;justify-content:space-between;background:rgba(8,7,6,.72);backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.08)}.brand{display:flex;align-items:center;gap:12px;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:-.02em}.brand img{width:52px;height:52px;object-fit:contain}.brand span{white-space:nowrap}nav{display:flex;gap:34px;font-size:13px;color:#c9c4bc}nav a:hover{color:#fff}.pill{border-radius:999px;padding:13px 21px;font-size:13px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;border:1px solid transparent;transition:.2s ease}.pill:hover{transform:translateY(-2px)}.light{background:#f4f1eb;color:#0a0908}.gold{background:var(--gold);color:#0b0906}.ghost{border-color:#575149;background:rgba(8,7,6,.4)}.hero{min-height:100vh;position:relative;display:grid;grid-template-columns:1.1fr .7fr;align-items:center;padding:120px 7vw 70px;overflow:hidden}.hero-bg{position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,6,5,.96) 0%,rgba(7,6,5,.75) 50%,rgba(7,6,5,.28) 100%),url('https://images.unsplash.com/photo-1487754180451-c456f719a1fc?auto=format&fit=crop&w=2200&q=86') center/cover;filter:saturate(.72)}.hero:after{content:"";position:absolute;inset:auto 0 0;height:30%;background:linear-gradient(transparent,var(--black))}.hero-copy,.hero-logo{position:relative;z-index:2}.eyebrow{font-size:11px;letter-spacing:.19em;color:#d39a4b;font-weight:700}.hero h1,.intro h2,.section-head h2,.coverage h2,.contact h2{font-size:clamp(50px,7vw,112px);line-height:.9;letter-spacing:-.065em;margin:24px 0}.hero h1 em{font-family:'Playfair Display',serif;font-weight:700;color:#d5a258}.hero p{max-width:620px;color:#c4beb4;font-size:17px;line-height:1.7}.actions{display:flex;gap:10px;margin-top:34px}.hero-logo{justify-self:end;width:min(37vw,510px)}.hero-logo img{width:100%;filter:drop-shadow(0 22px 35px rgba(0,0,0,.6))}.scroll{position:absolute;z-index:3;bottom:35px;left:7vw;font-size:9px;letter-spacing:.18em;color:#8f887f;display:flex;gap:12px;align-items:center}.scroll i{width:55px;height:1px;background:#5e5850}.intro{padding:150px 7vw;max-width:1500px}.intro h2{font-size:clamp(52px,7vw,105px)}.intro h2 span{color:#6f6960}.intro p{margin-left:auto;max-width:520px;font-size:18px;line-height:1.7;color:var(--muted)}.services,.work{padding:60px 7vw 140px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:50px}.section-head h2{font-size:clamp(46px,5vw,80px);margin-bottom:0}.section-head p{max-width:390px;color:var(--muted);line-height:1.6}.service-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.service{height:430px;border-radius:28px;overflow:hidden;position:relative;padding:28px;background:linear-gradient(180deg,rgba(8,7,6,.08),rgba(8,7,6,.95)),var(--img) center/cover;border:1px solid rgba(255,255,255,.09);display:flex;flex-direction:column;justify-content:space-between;transition:transform .3s ease,border .3s}.service:hover{transform:translateY(-5px);border-color:#8b6736}.service>span{font-size:11px;color:#d2c7b7}.service h3{font-size:31px;letter-spacing:-.04em;margin:0 0 8px}.service p{color:#c2bbb1;max-width:420px;line-height:1.5}.video-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.video-grid figure{margin:0;background:#111;border-radius:28px;overflow:hidden;border:1px solid #292620}.video-grid video{width:100%;aspect-ratio:9/12;max-height:760px;object-fit:cover;display:block;background:#0c0b09}.video-grid figcaption{padding:18px 22px;display:flex;justify-content:space-between;font-size:13px;color:#c9c2b7}.coverage{display:grid;grid-template-columns:1fr 1fr;min-height:750px}.coverage-photo{background:linear-gradient(180deg,rgba(8,7,6,.06),rgba(8,7,6,.18)),url('https://images.unsplash.com/photo-1487754180451-c456f719a1fc?auto=format&fit=crop&w=1800&q=88') center/cover}.coverage-copy{padding:10vw 7vw;background:#11100e;display:flex;flex-direction:column;justify-content:center}.coverage h2{font-size:clamp(55px,6vw,95px)}.coverage-copy>p{color:var(--muted)}.places{display:flex;flex-wrap:wrap;gap:8px;margin:35px 0}.places span{padding:11px 15px;border:1px solid #39342d;border-radius:999px;font-size:12px}.text-link{font-size:14px;color:#d8a65f}.contact{padding:140px 7vw;display:grid;grid-template-columns:.8fr 1fr;gap:9vw;background:#e8dfd0;color:#12100d}.contact .eyebrow{color:#85591f}.contact h2{font-size:clamp(52px,6vw,94px)}.contact-copy p{color:#6f685f;line-height:1.6;max-width:440px}.contact-copy>a{font-size:25px;font-weight:700}.contact form{display:grid;gap:18px}.row{display:grid;grid-template-columns:1fr 1fr;gap:14px}label{font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase}input,select,textarea{display:block;width:100%;margin-top:9px;border:0;border-bottom:1px solid #aaa094;background:transparent;padding:15px 2px;font:500 16px Inter;color:#12100d;outline:none;border-radius:0}textarea{resize:vertical}.contact button{border:0;width:max-content;padding:16px 24px}.contact .gold{background:#18140f;color:#fff}footer{min-height:150px;padding:35px 7vw;display:flex;align-items:center;justify-content:space-between;gap:20px;color:#918a80;font-size:12px}footer div{display:flex;align-items:center;gap:10px;color:#eee8df}footer img{width:54px;height:54px;object-fit:contain}.progress{position:fixed;z-index:50;top:0;left:0;height:2px;background:#d19747;width:0}.reveal{opacity:0;transform:translateY(22px);transition:opacity .65s cubic-bezier(.2,.7,.2,1),transform .65s cubic-bezier(.2,.7,.2,1)}.reveal.in{opacity:1;transform:none}@media(max-width:800px){header{height:68px;padding:0 18px}.brand span,nav{display:none}.hero{grid-template-columns:1fr;padding:110px 22px 70px;align-content:center}.hero-logo{position:absolute;right:-60px;top:110px;width:270px;opacity:.26}.hero h1{font-size:58px}.hero p{font-size:15px;max-width:90%}.actions{flex-wrap:wrap}.intro,.services,.work,.contact{padding:90px 22px}.section-head{display:block}.service-grid,.video-grid,.coverage,.contact{grid-template-columns:1fr}.service{height:350px}.coverage-photo{height:460px}.coverage-copy{padding:80px 22px}.row{grid-template-columns:1fr}footer{padding:30px 22px;align-items:flex-start;flex-direction:column}.video-grid video{aspect-ratio:9/13}.hero-bg{background-position:60% center}}
